# ==============================================================================
# ChronoVision AI — Multimodal Semantic Video Search Environment Configuration
# ==============================================================================

# Causal Explainability (Gemini 3.5 Flash Lite)
GEMINI_API_KEY="your-gemini-api-key-here"
GEMINI_MODEL="gemini-3.5-flash-lite"

# Vector Database (Qdrant)
QDRANT_HOST="localhost"
QDRANT_PORT=6333
QDRANT_COLLECTION="sih_video_keyframes"

# Vision-Language Model Engine (vLLM Qwen2-VL)
VLM_HOST="http://localhost:8001"
MODEL_NAME="Qwen/Qwen2-VL-7B-Instruct"
GPU_MEMORY_UTILIZATION=0.85
MAX_MODEL_LEN=4096

# Speech & OCR Models
WHISPER_MODEL_SIZE="base"
OCR_ENGINE="paddleocr"

# Backend & Web Configuration
ENVIRONMENT="development"
NEXT_PUBLIC_API_URL="http://localhost:8000"
APP_PORT=3000
API_PORT=8000
